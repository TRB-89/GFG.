# GFG Backend Environment Configuration Template (No Secrets)
# Copy to .env for local development

# Database connection URL (defaults to SQLite in dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./gfg_local.db

# Allowed CORS origins (comma-separated list of frontends)
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# JWT Authentication
JWT_SECRET=change_me_to_a_cryptographically_secure_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Environment: development | demonstration | staging | production
ENVIRONMENT=development

# Optional AI / LLM Integration Key
AI_API_KEY=

# Document upload storage root directory (defaults to backend/storage)
STORAGE_ROOT=./backend/storage
