# GFG Frontend Environment Variable Template (No Secrets)
# Copy to .env.local for local development or configure in deployment platform (e.g. Vercel / Cloudflare Pages / NIC MeghRaj)

# Backend API Base URL (leave blank in dev to use Next.js rewrites/proxy or fallback mock layer)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Environment Mode: development | staging | production | demo
NEXT_PUBLIC_ENVIRONMENT=development

# Telemetry and logging (optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
